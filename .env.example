# API Configuration
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.3

# Server Configuration
PORT=3000

# Escalation Thresholds
CONFIDENCE_THRESHOLD=0.7

# Google Sheets Configuration (Optional)
# To enable Google Sheets integration:
# 1. Create a Google Sheet and copy its ID from the URL
# 2. Follow setup instructions in GOOGLE_SHEETS_SETUP.md
# 3. Uncomment and configure the variables below

# Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
# GOOGLE_SHEET_ID=your-sheet-id-here

# Google Service Account JSON (get from Google Cloud Console)
# Create a service account, download JSON, and paste the entire content as ONE LINE
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
