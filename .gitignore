# .gitignore

# Dependencies
node_modules/
package-lock.json

# Environment variables (never commit!)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Output files (optional - can commit sample results)
output/results.json

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Temporary files
temp/
tmp/
*.tmp
*.bak

# Google service account keys (security)
*service-account*.json
credentials.json

# MailHog (if downloaded locally)
mailhog/
mailhog.exe
MailHog*
